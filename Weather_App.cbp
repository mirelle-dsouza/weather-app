<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Weather_App" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Weather_App" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="../../../../../Program Files/CodeBlocks/MinGW/include" />
				</Compiler>
				<Linker>
					<Add option="-lcurl" />
					<Add option="-lws2_32" />
					<Add option="-lwldap32" />
					<Add option="-lwinmm" />
					<Add directory="../../../../../Program Files/CodeBlocks/MinGW/lib" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Weather_App" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="../curl-8.7.1_3-win64-mingw/include" />
			<Add directory="include" />
		</Compiler>
		<Linker>
			<Add library="libcurl.dll.a" />
			<Add directory="../curl-8.7.1_3-win64-mingw/lib" />
		</Linker>
		<Unit filename="cJSON.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
